# Dependencies
node_modules/
example/node_modules/

# Library build output is generated by react-native-builder-bob.
lib/

# Expo local state and generated web output
.expo/
example/.expo/
example/.expo-shared/
example/dist/
example/web-build/

# Generated native example projects stay local. Recreate them with
# `yarn example prebuild`; the library's android/ and ios/ directories are source.
example/android/
example/ios/

# Native build products
android/.gradle/
android/build/
android/local.properties
ios/Pods/
ios/build/
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcuserstate

# Test and tooling output
coverage/
*.tsbuildinfo
.eslintcache
.turbo/

# Logs and local environment
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*
!.env.example

# Editors and operating systems
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
